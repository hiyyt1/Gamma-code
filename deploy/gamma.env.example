NODE_ENV=production
LANG=C.UTF-8
LC_ALL=C.UTF-8
GAMMA_WORKSPACES_ROOT=/home/gamma/workspaces
GAMMA_SKILL_MARKET_ROOT=/opt/gamma/gamma-skill-market
OPENCODE_DB=/var/lib/gamma/opencode.db
XDG_DATA_HOME=/var/lib/gamma/data
XDG_STATE_HOME=/var/lib/gamma/state
XDG_CACHE_HOME=/var/lib/gamma/cache
XDG_CONFIG_HOME=/var/lib/gamma/config
GAMMA_BACKEND_PORT=4096
GAMMA_BACKEND_URL=http://127.0.0.1:4096
GAMMA_WEB_PORT=4444
GAMMA_PUBLIC_ORIGIN=https://gamma.example.com
GAMMA_AUTH_CONFIG=/etc/gamma/auth.json
# Set only behind the supplied loopback Nginx proxy, which overwrites X-Real-IP.
GAMMA_TRUST_PROXY=1
# Optional static website preview. Requires deploy/gamma-preview.nginx.conf.example.
# Use an independent registrable domain with wildcard DNS/TLS; no Gamma cookies there.
# GAMMA_PREVIEW_DOMAIN=preview.example.net
# GAMMA_PREVIEW_PORT=4097

# Required beside the bundled backend when running a compiled binary.
GAMMA_AGENT_MARKET_ROOT=/opt/gamma/gamma-agent-market

# Manual deployments: copy deploy/opencode.json to this root-owned path.
OPENCODE_CONFIG=/etc/gamma/opencode.json
OPENCODE_DISABLE_PROJECT_CONFIG=1
# Native, keyless Exa search (free, rate limited). No paid API credentials.
OPENCODE_ENABLE_EXA=1
OPENCODE_WEBSEARCH_PROVIDER=exa
GAMMA_KNOWLEDGE_ROOT=/var/lib/gamma/knowledge
# Install the lockfile-pinned Chromium here as the build user before activation.
PLAYWRIGHT_BROWSERS_PATH=/opt/gamma/.playwright
